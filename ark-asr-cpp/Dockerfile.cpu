# ==============================================================
# CrispASR CPU-Runtime — pre-compiled CPU release binary (kein CUDA)
# ==============================================================
# Baut dasselbe CrispASR-Backend ohne NVIDIA-GPU-Anforderung.
# Asset: crispasr-linux-x86_64.tar.gz (ohne -cuda Suffix).
FROM ubuntu:24.04

ARG CRISPASR_VERSION=v0.8.25

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

# Download CrispASR pre-compiled Linux CPU binary from GitHub release
RUN wget -q "https://github.com/CrispStrobe/CrispASR/releases/download/${CRISPASR_VERSION}/crispasr-linux-x86_64.tar.gz" \
    -O /tmp/crispasr.tar.gz && \
    tar xzf /tmp/crispasr.tar.gz -C /tmp && \
    cp /tmp/crispasr-linux-x86_64/crispasr /usr/local/bin/crispasr && \
    cp /tmp/crispasr-linux-x86_64/libc2pa_c.so /usr/local/lib/libc2pa_c.so && \
    ldconfig && \
    chmod +x /usr/local/bin/crispasr && \
    rm -rf /tmp/crispasr.tar.gz /tmp/crispasr-linux-x86_64

# Verify
RUN crispasr --help 2>&1 | head -5

# Model volume — mount GGUF files here
RUN mkdir -p /models

EXPOSE 8080

ENV ARK_ASR_MODEL=/models/ark-asr-3b-q8_0.gguf

CMD ["sh", "-c", "exec crispasr --server -m \"$ARK_ASR_MODEL\" --host 0.0.0.0 --port 8080"]
